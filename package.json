{
  "name": "claude-auto-retry",
  "version": "2026.11.3",
  "description": "Continue Claude Code past the usage limits and API errors it won't continue on its own",
  "type": "module",
  "bin": {
    "claude-auto-retry": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc --noCheck -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm test"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "rate-limit",
    "retry",
    "pty",
    "node-pty",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-karl/claude-auto-retry.git"
  },
  "homepage": "https://github.com/chris-karl/claude-auto-retry#readme",
  "bugs": {
    "url": "https://github.com/chris-karl/claude-auto-retry/issues"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "knip": "^6.45.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
